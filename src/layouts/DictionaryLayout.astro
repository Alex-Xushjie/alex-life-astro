---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const title = frontmatter?.title || 'Network Engineering English Dictionary';
---
<BaseLayout title={title} description="An illustrated English dictionary for network engineers.">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav aria-label="Dictionary navigation" class="mb-8 text-sm text-[var(--color-text-secondary)]">
      <a href="/dictionary/" class="hover:text-primary">Dictionary</a>
      <span aria-hidden="true"> / </span><a href="/dictionary/#visual-pages" class="hover:text-primary">Chapter 01</a>
    </nav>
    <div class="mb-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] px-5 py-4 text-sm text-[var(--color-text-secondary)]">
      Preview edition · Chapter 01 is a draft for review. Illustrations are illustrative, and technical and language review is ongoing.
    </div>
    <article class="prose max-w-none dictionary-content"><slot /></article>
  </div>
</BaseLayout>
<style>
  .dictionary-content :global(img) { display:block; width:100%; height:auto; border-radius:1rem; background:#f4f7f6; }
  .dictionary-content :global(table) { width:100%; display:block; overflow-x:auto; }
  .dictionary-content :global(th), .dictionary-content :global(td) { padding:.65rem .8rem; text-align:left; vertical-align:top; }
  .dictionary-content :global(blockquote) { border-left:3px solid var(--color-primary); padding-left:1rem; }
  .dictionary-content :global(a) { color:var(--color-primary); overflow-wrap:anywhere; }
</style>
